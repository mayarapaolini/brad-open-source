# Adapters are disabled by default.
BRAD_ADAPTER_INKUS_ENABLED=false
# Inkus MCP endpoint. The token must come from your keychain or shell, not from this file.
BRAD_INKUS_MCP_URL=
# BRAD_INKUS_TOKEN=  (set in your environment, never commit it)
# Use a synthetic in-memory Inkus instead of a real one (demo/tests).
BRAD_INKUS_FAKE=0
BRAD_ADAPTER_OBSIDIAN_ENABLED=false
BRAD_ADAPTER_HERMES_ENABLED=false

# Store real credentials in the operating-system keychain or a secret manager.
# Never place tokens in this file.
