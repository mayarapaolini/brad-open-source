{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brad:agent-spec:v1",
  "title": "Brad Agent Spec v1",
  "description": "Open, readable definition of one agent. Draft: subject to RFC-002 (not yet approved). Contains no secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "id", "name", "mission", "scope", "permissions", "confirmRequired", "models", "routines", "channels", "contextIsolation"],
  "properties": {
    "specVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains"],
      "properties": {
        "domains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "description": { "type": "string" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "confirmRequired": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Actions that always need explicit owner confirmation at run time."
    },
    "models": {
      "type": "object",
      "description": "Model per role, for example plan, implement, search. Values are model identifiers.",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "routines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "schedule", "budget"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "schedule": { "type": "string", "minLength": 1 },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxSeconds", "maxToolCalls", "maxCostUsd"],
            "properties": {
              "maxSeconds": { "type": "integer", "minimum": 1 },
              "maxToolCalls": { "type": "integer", "minimum": 0 },
              "maxCostUsd": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "route"],
        "properties": {
          "channel": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contextIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "bridges"],
      "properties": {
        "context": { "type": "string", "enum": ["personal", "work"] },
        "bridges": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "description": "Other contexts this agent may act in, listed by the owner." }
      }
    }
  }
}
